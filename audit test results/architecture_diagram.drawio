        <!-- User Devices -->
        <mxCell id="u" value="Farmer / Agent (Mobile PWA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#2b6cb0;" vertex="1" parent="1">
